<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <MetricsLayer>infrastructure</MetricsLayer>
    <RootNamespace>Metrics.GitHub</RootNamespace>
  </PropertyGroup>

  <!--
    GitHub source-control adapter, loaded at runtime as a metrics extension
    (see MetricsExtensions:Extensions in configs/appsettings.json). The assembly
    file name is part of that configuration contract - do not rename it without
    updating the configuration.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Api/Resources/**/*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Core/Metrics.Domain/Metrics.Domain.csproj" />
    <ProjectReference Include="../../Core/Metrics.Application/Metrics.Application.csproj" />
    <ProjectReference Include="../Metrics.Infrastructure/Metrics.Infrastructure.csproj" />
  </ItemGroup>

</Project>
