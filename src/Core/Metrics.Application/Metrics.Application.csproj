<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <MetricsLayer>application</MetricsLayer>
    <RootNamespace>Metrics.Application</RootNamespace>
  </PropertyGroup>

  <!--
    Use cases and ports. Depends on Metrics.Domain plus abstraction-only
    Microsoft.Extensions packages. No EF Core, no database provider, no
    ASP.NET Core, no Finbuckle runtime, no HTTP stack: those belong to
    Metrics.Infrastructure, which implements the ports declared here.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.OData.ModelBuilder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Metrics.Domain/Metrics.Domain.csproj" />
  </ItemGroup>

</Project>
