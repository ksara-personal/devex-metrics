{
  "GitActivity": {
    // GitHub PAT with repo + read:user (and read:org for private org repos). Prefer the GITHUB_TOKEN env var.
    "PAT": "",
    // Shared SQLite database used for every repository.
    "DatabasePath": "gitactivity.db",
    // Branch to read commit history from. Empty = the repository's default branch.
    "CommitBranch": "",
    // Total minutes a run may sleep on GitHub rate limits; past that it stops and the next run resumes.
    "RateLimitMaxWaitMinutes": 60,
    // Created-date span per PR search (GitHub search caps at 1000 results; narrowed automatically).
    "SearchChunkDays": 30,
    // GitHub hides private emails; map login -> email to join with the HR/contractor roster.
    "UserEmails": {
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "System.Net.Http": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
