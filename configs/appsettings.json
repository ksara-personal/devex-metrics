    "Organization": "your-ado-org",
    "Fields": [
      "System.Title",
      "System.State",
      "System.AssignedTo",
      "System.CreatedDate",
      "System.CreatedBy",
      "System.CommentCount",
      "System.WorkItemType",
      "Microsoft.VSTS.Common.Priority",
      "Microsoft.VSTS.Common.ClosedDate",
      "Microsoft.VSTS.Common.ClosedBy",
      "Microsoft.VSTS.Common.Severity",
      "Custom.ProductType",
      "Custom.AffectsVersions",
      "Custom.NoFixReason",
      "Custom.Regression",
      "Custom.NumberofClients",
      "Custom.IssueSource",
      "Custom.Environment",
      "Custom.MergedVersions",
      "Custom.VerifiedVersions",
      "System.Description",
      "System.Tags",
      "System.AreaPath",
      "System.IterationPath",
      "System.AreaLevel3"
